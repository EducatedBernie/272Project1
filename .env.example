# === REQUIRED ===
DATABASE_URL=postgresql://chalkboard:localdev@localhost:5432/chalkboard
GEMINI_API_KEY=your-gemini-api-key-here
DASHBOARD_PASSWORD=pick-a-strong-password
AUTH_SECRET=generate-with-python3-c-import-secrets-print-secrets-token_hex-32

# === REQUIRED FOR UPLOADS (R2) ===
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# === REQUIRED FOR GCP/CHIRP (uploaded videos need speech-to-text) ===
# GOOGLE_APPLICATION_CREDENTIALS_JSON=base64-encoded-service-account-key
# GOOGLE_CLOUD_PROJECT=

# === RECOMMENDED ===
# CHALKBOARD_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# CHALKBOARD_BASE_URL=https://app.your-domain.com  # custom domain on Railway, used for Slack viewer links

# === OPTIONAL (reasonable defaults) ===
# NOTES_MODEL=gemini-3.7-flash  # on-demand study notes only
# WORKER_POLL_INTERVAL=5
# WORKER_HEARTBEAT_INTERVAL=60
# WORKER_STALE_THRESHOLD_MINUTES=5
# WORKER_STUCK_ALERT_MINUTES=30
# CHALKBOARD_GCS_BUCKET=chalkboard-audio-staging
